--- a/dlls/msado15/command.c
+++ b/dlls/msado15/command.c
@@ -404,10 +404,49 @@
     return S_OK;
 }
 
+/* The VARIANT form of ActiveConnection, which is what IDispatch-based callers
+ * (scripts, and anything doing cmd.ActiveConnection = conn) end up in. Accepts
+ * either a live connection object or a connection string, mirroring
+ * recordset_put_ActiveConnection, then hands off to the putref path. */
 static HRESULT WINAPI command_put_ActiveConnection( _Command *iface, VARIANT connection )
 {
-    FIXME( "%p, %s\n", iface, debugstr_variant(&connection) );
-    return E_NOTIMPL;
+    _Connection *conn = NULL;
+    HRESULT hr;
+
+    TRACE( "%p, %s\n", iface, debugstr_variant(&connection) );
+
+    switch (V_VT( &connection ))
+    {
+    case VT_EMPTY:
+    case VT_NULL:
+        break;
+
+    case VT_BSTR:
+        if (FAILED(hr = Connection_create( (void **)&conn ))) return hr;
+        hr = _Connection_Open( conn, V_BSTR( &connection ), NULL, NULL, adConnectUnspecified );
+        if (FAILED(hr))
+        {
+            _Connection_Release( conn );
+            return hr;
+        }
+        break;
+
+    case VT_UNKNOWN:
+    case VT_DISPATCH:
+        if (!V_UNKNOWN( &connection )) return MAKE_ADO_HRESULT( adErrInvalidConnection );
+        hr = IUnknown_QueryInterface( V_UNKNOWN( &connection ), &IID__Connection, (void **)&conn );
+        if (FAILED(hr)) return hr;
+        break;
+
+    default:
+        FIXME( "unsupported connection %s\n", debugstr_variant(&connection) );
+        return E_NOTIMPL;
+    }
+
+    hr = command_putref_ActiveConnection( iface, conn );
+    /* putref took its own reference (or cleared the slot for a NULL conn). */
+    if (conn) _Connection_Release( conn );
+    return hr;
 }
 
