+/* Walk the rowset once and count its rows, leaving the cursor back at the
+ * start. Only worth doing for an adUseClient recordset: there, real ADO hands
+ * the rows to the client cursor engine, which fetches all of them up front, so
+ * the extra pass costs what Windows already pays -- and it is the only way to
+ * answer RecordCount for a provider that does not implement IRowsetExactScroll.
+ * A server-side cursor is left alone; fetching it eagerly would be a real
+ * regression.
+ *
+ * Called before the recordset has been positioned, so RestartPosition puts the
+ * cursor back exactly where the caller expects to find it. */
+static void count_rows( struct recordset *recordset )
+{
+    DBCOUNTITEM obtained, total = 0;
+    HROW buf[64], *rows = buf;
+    IRowsetExactScroll *es;
+    HRESULT hr;
+    VARIANT v;
+
+    recordset->row_count = -1;
+
+    if (recordset->cursor_location != adUseClient) return;
+    /* An exact count is available for free; no need to walk anything. */
+    if (SUCCEEDED(IRowset_QueryInterface( recordset->row_set, &IID_IRowsetExactScroll, (void **)&es )))
+    {
+        IRowsetExactScroll_Release( es );
+        return;
+    }
+    /* Without this the walk is one-way and there is no getting back. */
+    if (!recordset_get_prop( recordset, &DBPROPSET_ROWSET, DBPROP_CANSCROLLBACKWARDS, &v ) || !V_BOOL( &v ))
+        return;
+
+    for (;;)
+    {
+        rows = buf;
+        hr = IRowset_GetNextRows( recordset->row_set, DB_NULL_HCHAPTER, 0, ARRAY_SIZE(buf), &obtained, &rows );
+        if (FAILED(hr)) break;
+        total += obtained;
+        if (obtained) IRowset_ReleaseRows( recordset->row_set, obtained, rows, NULL, NULL, NULL );
+        if (obtained < ARRAY_SIZE(buf)) break;
+    }
+
+    if (SUCCEEDED(hr)) hr = IRowset_RestartPosition( recordset->row_set, DB_NULL_HCHAPTER );
+    if (FAILED(hr))
+    {
+        /* Bail out rather than guess: a half-walked rowset with a made-up count
+         * would be worse than the -1 the caller already copes with. */
+        WARN( "could not count rows, hr %#lx\n", hr );
+        return;
+    }
+
+    TRACE( "counted %Iu rows\n", total );
+    recordset->row_count = total;
+}
